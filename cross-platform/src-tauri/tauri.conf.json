{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "塞壬唱片下载器",
  "version": "1.3.0",
  "identifier": "com.mxwf0.siren-records-downloader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "塞壬唱片下载器",
        "width": 1040,
        "height": 760,
        "minWidth": 720,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "decorations": false,
        "backgroundColor": "#f4f8fd"
      }
    ],
    "security": {
      "csp": "default-src 'self'; font-src 'self'; img-src 'self' asset: data: https://web.hycdn.cn; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https://monster-siren.hypergryph.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "跨平台塞壬唱片音乐下载工具",
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "entitlements": "Entitlements.plist",
      "signingIdentity": "-"
    }
  }
}
