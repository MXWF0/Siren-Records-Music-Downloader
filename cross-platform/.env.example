# Leave empty when the frontend and /api functions are deployed together.
# For a separate static host, set this to the proxy origin, for example:
# VITE_API_BASE_URL=https://your-siren-proxy.example
VITE_API_BASE_URL=

# Comma-separated browser origins allowed to call the proxy.
SIREN_ALLOWED_ORIGINS=https://mxwf0.github.io,http://127.0.0.1:4173
SIREN_AUDIO_RATE_LIMIT=8
SIREN_CATALOG_RATE_LIMIT=60
SIREN_RATE_LIMIT_WINDOW_MS=60000
SIREN_MAX_AUDIO_BYTES=1073741824
SIREN_AUDIO_HOSTS=hycdn.cn
